# ==================== FUNCTION: CSV ====================
create_csv() {
    local DATE=$1
    local HISTORY_DATA=$2
    local ORIGINAL_USER="${SUDO_USER:-$USER}"
    local AUDIT_DIR="/home/$ORIGINAL_USER/Audits"
    local CSV_FILE="$AUDIT_DIR/zypper-history-${DATE}.csv"

    mkdir -p "$AUDIT_DIR"
    chown "$ORIGINAL_USER:$ORIGINAL_USER" "$AUDIT_DIR"
    chmod 0755 "$AUDIT_DIR"

    if [[ -f "$CSV_FILE" ]]; then
        read -p "${MSG[csv_exists]} " replace
        if ! [[ "$replace" =~ ^[Oo] ]]; then
            echo "Annulation."; return
        fi
    fi

    echo "Date,Heure,Type,Action,Utilisateur,Paquet,Version,Architecture,Depot,Commande" > "$CSV_FILE"

    local CMD_DATA PKG_DATA
    CMD_DATA=$(echo "$HISTORY_DATA" | grep "|command|" || true)
    PKG_DATA=$(echo "$HISTORY_DATA" | grep -E "\|install\||\|remove ?\|" || true)

    if [[ -n "$CMD_DATA" ]]; then
        echo "$CMD_DATA" | awk -F'|' '{
            date = $1; time = substr(date, 12); date = substr(date, 1, 10)
            type = $2; utilisateur = $3; commande = $4
            for (i=5; i<=NF; i++) commande = commande "|" $i
            gsub(/"/, "\"\"", commande)
            printf "%s,%s,%s,,%s,,,,,\"%s\"\n", date, time, type, utilisateur, commande
        }' >> "$CSV_FILE"
    fi

    if [[ -n "$PKG_DATA" ]]; then
        echo "$PKG_DATA" | awk -F'|' '{
            date = $1; time = substr(date, 12); date = substr(date, 1, 10)
            type = "package"; action = $2; gsub(/ /, "", action)
            paquet = $3; version = $4; arch = $5; depot = $7
            printf "%s,%s,%s,%s,,%s,%s,%s,%s,\n", date, time, type, action, paquet, version, arch, depot
        }' >> "$CSV_FILE"
    fi

    chown "$ORIGINAL_USER:$ORIGINAL_USER" "$CSV_FILE"
    chmod 0600 "$CSV_FILE"

    echo ""
    echo "${MSG[csv_created]}"
    echo "   ${MSG[csv_path]} $CSV_FILE"
    echo "${MSG[csv_size]} $(du -h "$CSV_FILE" | cut -f1)"
    echo "${MSG[csv_lines]} $(wc -l < "$CSV_FILE")"
}

# ==================== FONCTION: Lister les jours disponibles ====================
list_available_dates() {
    if [[ ! -f /var/log/zypp/history ]]; then
        echo "${MSG[no_history]}"; return
    fi
    echo ""
    echo "${MSG[available_dates]}"
    echo "===================================================================================="
    grep -v '^#' /var/log/zypp/history | \
        awk -F'|' '{print substr($1,1,10)}' | \
        grep -E '^[0-9]{4}-[0-9]{2}-[0-9]{2}$' | \
        sort -u | \
        while read -r date; do
            local nb_actions nb_cmds
            nb_actions=$(grep "^${date}" /var/log/zypp/history | grep -cE "\|install\||\|remove ?\|" || true)
            nb_cmds=$(grep "^${date}" /var/log/zypp/history | grep -c "|command|" || true)
            printf "  📅 %-12s  %2d paquet(s) install/supprimé(s)   %2d commande(s)\n" \
                "$date" "$nb_actions" "$nb_cmds"
        done
    echo "===================================================================================="
    echo ""
}

# ==================== FONCTION: Afficher historique (réutilisable) ====================
display_history() {
    local DATE=$1
    local HISTORY_DATA=$2
    local FILTER="${3:-}"   # installs | removes | "" (tout)

    local COMMAND_DATA PACKAGE_DATA REPO_DATA
    COMMAND_DATA=$(echo "$HISTORY_DATA" | grep "|command|" || true)
    PACKAGE_DATA=$(echo "$HISTORY_DATA" | grep -E "\|install\||\|remove ?\|" || true)
    REPO_DATA=$(echo "$HISTORY_DATA" | grep -E "\|radd\||\|rremove\|" || true)

    # Appliquer le filtre
    case "$FILTER" in
        installs)
            PACKAGE_DATA=$(echo "$PACKAGE_DATA" | grep "|install|" || true)
            COMMAND_DATA=""
            ;;
        removes)
            PACKAGE_DATA=$(echo "$PACKAGE_DATA" | grep -E "\|remove ?\|" || true)
            COMMAND_DATA=""
            ;;
    esac

    echo -e "${COLOR[DATE]}${MSG[select_date]} $DATE${COLOR[RESET]}"
    echo "===================================================================================="
    echo ""

    if [[ -n "$COMMAND_DATA" && "$FILTER" == "" ]]; then
        echo -e "${COLOR[HEADER]}${MSG[commands_title]} - $DATE${COLOR[RESET]}"
        echo "===================================================================================="
        echo "$COMMAND_DATA" | awk -F'|' 'BEGIN {
            print "Date/Heure          | Type    | Utilisateur        | Commande"
            print "=========================================================================="
        } {
            heure = $1; type = $2; utilisateur = $3; commande = $4
            for (i=5; i<=NF; i++) commande = commande "|" $i
            printf "%-20s| %-7s| %-18s| %s\n", heure, type, utilisateur, commande
        }'
        echo ""
    fi

    if [[ -n "$PACKAGE_DATA" ]]; then
        local title
        case "$FILTER" in
            installs) title="${MSG[installs_title]}" ;;
            removes)  title="${MSG[removes_title]}" ;;
            *)        title="${MSG[packages_title]}" ;;
        esac
        echo -e "${COLOR[HEADER]}${title} - $DATE${COLOR[RESET]}"
        echo "===================================================================================="
        echo "$PACKAGE_DATA" | awk -F'|' 'BEGIN {
            print "Date/Heure          | Action   | Paquet                      | Version      | Arch"
        } {
            heure = $1; action = $2; gsub(/ /, "", action)
            paquet = $3; version = $4; arch = $5; depot = $7
            printf "%-20s| %-8s| %-27s| %-12s| %s\n", heure, action, paquet, version, arch
            printf "  └─ Dépôt: %s\n", depot
        }' | while IFS= read -r line; do
            if [[ "$line" =~ "Dépôt:" ]]; then
                local depot colored_depot
                depot=$(echo "$line" | sed 's/.*Dépôt: //')
                colored_depot=$(color_depot "$depot")
                echo "$line" | sed "s/Dépôt: .*/Dépôt: $colored_depot/"
            elif [[ "$line" =~ "install" ]]; then
                echo "$line" | sed "s/| install /| $(color_action 'install') /"
            elif [[ "$line" =~ "remove" ]]; then
                echo "$line" | sed "s/| remove /| $(color_action 'remove') /"
            else
                echo "$line"
            fi
        done
        echo ""
    fi

    if [[ -n "$REPO_DATA" && "$FILTER" == "" ]]; then
        echo -e "${COLOR[HEADER]}${MSG[repos_title]} - $DATE${COLOR[RESET]}"
        echo "===================================================================================="
        echo "$REPO_DATA" | awk -F'|' 'BEGIN {
            print "Date/Heure          | Action   | Alias/URL"
            print "=========================================================================="
        } {
            heure = $1; action = $2; alias = $3; detail = $4
            printf "%-20s| %-8s| %s %s\n", heure, action, alias, detail
        }' | while IFS= read -r line; do
            if [[ "$line" =~ "radd" ]]; then
                echo -e "${COLOR[INSTALL]}${line}${COLOR[RESET]}"
            elif [[ "$line" =~ "rremove" ]]; then
                echo -e "${COLOR[REMOVE]}${line}${COLOR[RESET]}"
            else
                echo "$line"
            fi
        done
        echo ""
    fi

    if [[ -z "$COMMAND_DATA" && -z "$PACKAGE_DATA" && -z "$REPO_DATA" ]]; then
        echo "${MSG[no_data]} $DATE"
        echo ""
    fi
}

# ==================== NOUVELLE FONCTION: Recherche paquet ====================
search_package() {
    local PKG=$1
    if [[ ! -f /var/log/zypp/history ]]; then
        echo "${MSG[no_history]}"; exit 1
    fi

    local RESULTS
    RESULTS=$(grep -i "|${PKG}" /var/log/zypp/history | grep -E "\|install\||\|remove ?\|" || true)

    if [[ -z "$RESULTS" ]]; then
        echo -e "${COLOR[REMOVE]}${MSG[no_package]} ${PKG}${COLOR[RESET]}"
        exit 0
    fi

    {
        echo ""
        echo -e "${COLOR[HEADER]}${MSG[search_title]} : ${COLOR[BOLD]}${PKG}${COLOR[RESET]}"
        echo "===================================================================================="
        echo ""
        echo "$RESULTS" | awk -F'|' 'BEGIN {
            print "Date/Heure          | Action   | Paquet                      | Version      | Dépôt"
            print "===================================================================================="
        } {
            heure = $1; action = $2; gsub(/ /, "", action)
            paquet = $3; version = $4; depot = $7
            printf "%-20s| %-8s| %-27s| %-12s| %s\n", heure, action, paquet, version, depot
        }' | while IFS= read -r line; do
            if [[ "$line" =~ "install" ]]; then
                echo "$line" | sed "s/| install /| $(color_action 'install') /"
            elif [[ "$line" =~ "remove" ]]; then
                echo "$line" | sed "s/| remove /| $(color_action 'remove') /"
            else
                echo "$line"
            fi
        done
        echo ""
        local total inst rem
        total=$(echo "$RESULTS" | wc -l)
        inst=$(echo "$RESULTS" | grep -c "|install|" || true)
        rem=$(echo "$RESULTS" | grep -cE "\|remove ?\|" || true)
        echo "Total : ${total} occurrence(s) — ${inst} install(s), ${rem} suppression(s)"
        echo ""
        echo "${MSG[search_help]}"
        echo "${MSG[quit_help]}"
    } | less -R
}

# ==================== NOUVELLE FONCTION: N derniers jours ====================
show_last_days() {
    local N=$1
    local FILTER="${2:-}"
    if [[ ! -f /var/log/zypp/history ]]; then
        echo "${MSG[no_history]}"; exit 1
    fi

    local DATES
    DATES=$(grep -v '^#' /var/log/zypp/history | \
        awk -F'|' '{print substr($1,1,10)}' | \
        grep -E '^[0-9]{4}-[0-9]{2}-[0-9]{2}$' | \
        sort -u | tail -n "$N")

    if [[ -z "$DATES" ]]; then
        echo "${MSG[no_history]}"; exit 0
    fi

    {
        echo ""
        echo -e "${COLOR[HEADER]}${MSG[last_days_title]} $N DERNIERS JOURS${COLOR[RESET]}"
        echo "===================================================================================="
        echo ""
        while read -r date; do
            local DATA
            DATA=$(grep "^${date}" /var/log/zypp/history 2>/dev/null || true)
            [[ -z "$DATA" ]] && continue
            display_history "$date" "$DATA" "$FILTER"
            echo "------------------------------------------------------------------------------------"
        done <<< "$DATES"
        echo "${MSG[search_help]}"
        echo "${MSG[quit_help]}"
    } | less -R
}

# ==================== NOUVELLE FONCTION: Statistiques globales ====================
show_stats() {
    if [[ ! -f /var/log/zypp/history ]]; then
        echo "${MSG[no_history]}"; exit 1
    fi

    local ALL_DATA
    ALL_DATA=$(grep -v '^#' /var/log/zypp/history | grep -E "\|install\||\|remove ?\|" || true)

    {
        echo ""
        echo -e "${COLOR[HEADER]}${MSG[stats_title]}${COLOR[RESET]}"
        echo "===================================================================================="
        echo ""

        local total inst rem first_date last_date
        total=$(echo "$ALL_DATA" | grep -c "." || true)
        inst=$(echo "$ALL_DATA"  | grep -c "|install|" || true)
        rem=$(echo "$ALL_DATA"   | grep -cE "\|remove ?\|" || true)
        first_date=$(grep -v '^#' /var/log/zypp/history | awk -F'|' 'NR==1 {print substr($1,1,10)}')
        last_date=$(grep -v '^#' /var/log/zypp/history  | awk -F'|' 'END {print substr($1,1,10)}')

        echo -e "${COLOR[BOLD]}Période couverte :${COLOR[RESET]} $first_date → $last_date"
        echo ""
        echo -e "${COLOR[BOLD]}Totaux :${COLOR[RESET]}"
        echo -e "  ${COLOR[INSTALL]}▶ Installations : ${inst}${COLOR[RESET]}"
        echo -e "  ${COLOR[REMOVE]}▶ Suppressions  : ${rem}${COLOR[RESET]}"
        echo -e "  ${COLOR[BOLD]}▶ Total         : ${total}${COLOR[RESET]}"
        echo ""

        echo -e "${COLOR[BOLD]}Top 10 paquets les plus installés :${COLOR[RESET]}"
        echo "$ALL_DATA" | grep "|install|" | awk -F'|' '{gsub(/ /,"",$3); print $3}' | \
            sort | uniq -c | sort -rn | head -10 | \
            awk '{printf "  %3d × %s\n", $1, $2}'
        echo ""

        echo -e "${COLOR[BOLD]}Top 10 paquets les plus supprimés :${COLOR[RESET]}"
        echo "$ALL_DATA" | grep -E "\|remove ?\|" | awk -F'|' '{gsub(/ /,"",$3); print $3}' | \
            sort | uniq -c | sort -rn | head -10 | \
            awk '{printf "  %3d × %s\n", $1, $2}'
        echo ""

        echo -e "${COLOR[BOLD]}Activité par dépôt :${COLOR[RESET]}"
        echo "$ALL_DATA" | awk -F'|' '{gsub(/ /,"",$7); if($7!="") print $7}' | \
            sort | uniq -c | sort -rn | \
            while read -r count repo; do
                local colored
                colored=$(color_depot "$repo")
                printf "  %4d × %b\n" "$count" "$colored"
            done
        echo ""

        echo -e "${COLOR[BOLD]}Activité par jour (top 10) :${COLOR[RESET]}"
        grep -v '^#' /var/log/zypp/history | grep -E "\|install\||\|remove ?\|" | \
            awk -F'|' '{print substr($1,1,10)}' | sort | uniq -c | sort -rn | head -10 | \
            awk '{printf "  %3d opération(s)  %s\n", $1, $2}'
        echo ""

        echo "${MSG[quit_help]}"
    } | less -R
}

# ==================== NOUVELLE FONCTION: Downgrades rétroactifs ====================
show_downgrades() {
    local N="${1:-30}"
    if [[ ! -f /var/log/zypp/history ]]; then
        echo "${MSG[no_history]}"; exit 1
    fi

    local ALL_DATA
    ALL_DATA=$(grep -v '^#' /var/log/zypp/history | grep -E "\|install\||\|remove ?\|" || true)

    local DATES
    DATES=$(echo "$ALL_DATA" | awk -F'|' '{print substr($1,1,10)}' | sort -u | tail -n "$N")

    {
        echo ""
        echo -e "${COLOR[HEADER]}${MSG[downgrades_title]}${COLOR[RESET]}"
        echo -e "${COLOR[TYPE]}${MSG[downgrades_hint]}${COLOR[RESET]}"
        echo "===================================================================================="
        echo ""

        local found=0
        while read -r date; do
            [[ -z "$date" ]] && continue
            local day_data removed installed candidates
            day_data=$(echo "$ALL_DATA" | grep "^${date}")
            removed=$(echo "$day_data" | grep -E "\|remove ?\|" | awk -F'|' '{gsub(/ /,"",$3); print $3}' | sort -u)
            installed=$(echo "$day_data" | grep "|install|" | awk -F'|' '{gsub(/ /,"",$3); print $3}' | sort -u)

            [[ -z "$removed" || -z "$installed" ]] && continue
            candidates=$(comm -12 <(echo "$removed") <(echo "$installed") 2>/dev/null || true)
            [[ -z "$candidates" ]] && continue

            echo -e "${COLOR[DATE]}$date${COLOR[RESET]}"
            while IFS= read -r pkg; do
                [[ -z "$pkg" ]] && continue
                local old_ver new_ver new_repo
                old_ver=$(echo "$day_data" | grep -E "\|remove ?\|" | awk -F'|' -v p="$pkg" '{gsub(/ /,"",$3); if($3==p) print $4}' | head -1)
                new_ver=$(echo "$day_data" | grep "|install|" | awk -F'|' -v p="$pkg" '{gsub(/ /,"",$3); if($3==p) print $4}' | head -1)
                new_repo=$(echo "$day_data" | grep "|install|" | awk -F'|' -v p="$pkg" '{gsub(/ /,"",$3); if($3==p) print $7}' | head -1)
                echo -e "  ${COLOR[REMOVE]}▼ ${pkg}${COLOR[RESET]}  ${old_ver} → ${new_ver}  ${COLOR[TYPE]}[${new_repo}]${COLOR[RESET]}"
                ((found++)) || true
            done <<< "$candidates"
            echo ""
        done <<< "$DATES"

        if [[ "$found" -eq 0 ]]; then
            echo "${MSG[no_downgrades]}"
            echo ""
        fi
        echo "${MSG[quit_help]}"
    } | less -R
}

# ==================== NOUVELLE FONCTION: Afficher log zyp-dup ====================
show_dup_log() {
    local LOG="/var/log/zypper-changes-detailed.log"
    if [[ ! -f "$LOG" ]]; then
        echo "${MSG[no_dup_log]}"
        exit 0
    fi
    {
        echo ""
        echo -e "${COLOR[HEADER]}${MSG[dup_log_title]}${COLOR[RESET]}"
        echo "===================================================================================="
        echo ""
        cat "$LOG"
        echo ""
        echo "${MSG[quit_help]}"
    } | less -R
}

# ==================== TRAITEMENT DES OPTIONS ====================
check_root "$@"
build_repo_colors

# Valeurs par défaut
FILTER_MODE=""
PACKAGE_SEARCH=""
LAST_DAYS=0
STATS_MODE=false
DOWNGRADES_MODE=false
DOWNGRADES_N=30
DUP_LOG_MODE=false
DATE_ARG=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)        show_help; exit 0 ;;
        -v|--version)     show_version; exit 0 ;;
        -i|--installs)    FILTER_MODE="installs"; shift ;;
        -r|--removes)     FILTER_MODE="removes"; shift ;;
        -p|--package)     PACKAGE_SEARCH="$2"; shift 2 ;;
        -l|--last)        LAST_DAYS="$2"; shift 2 ;;
        -s|--stats)       STATS_MODE=true; shift ;;
        -g|--downgrades)
            DOWNGRADES_MODE=true
            if [[ $# -gt 1 && "$2" =~ ^[0-9]+$ ]]; then
                DOWNGRADES_N="$2"; shift
            fi
            shift ;;
        -G|--dup-log)     DUP_LOG_MODE=true; shift ;;
        -d|--date)        DATE_ARG="$2"; validate_date_strict "$2" || exit 1; shift 2 ;;
        *) echo "${MSG[unknown_option]} $1 — ${MSG[usage_help]}" >&2; exit 1 ;;
    esac
done

# ==================== ROUTAGE ====================
# Recherche paquet — toutes dates
if [[ -n "$PACKAGE_SEARCH" ]]; then
    search_package "$PACKAGE_SEARCH"
    exit 0
fi

# Statistiques globales
if $STATS_MODE; then
    show_stats
    exit 0
fi

# Downgrades rétroactifs
if $DOWNGRADES_MODE; then
    show_downgrades "$DOWNGRADES_N"
    exit 0
fi

# Log détaillé zyp-dup
if $DUP_LOG_MODE; then
    show_dup_log
    exit 0
fi

# N derniers jours
if [[ "$LAST_DAYS" -gt 0 ]]; then
    show_last_days "$LAST_DAYS" "$FILTER_MODE"
    exit 0
fi

# Date directe (non interactif)
if [[ -n "$DATE_ARG" ]]; then
    HISTORY_DATA=$(grep "^${DATE_ARG}" /var/log/zypp/history 2>/dev/null || true)
    if [[ -z "$HISTORY_DATA" ]]; then
        echo "${MSG[no_data]} $DATE_ARG"; exit 0
    fi
    read -p "${MSG[ask_output]} " output_choice
    if [[ "$output_choice" =~ ^[Ff] ]]; then
        create_csv "$DATE_ARG" "$HISTORY_DATA"; exit 0
    fi
    { display_history "$DATE_ARG" "$HISTORY_DATA" "$FILTER_MODE"
      echo "${MSG[search_help]}"; echo "${MSG[quit_help]}"; } | less -R
    exit 0
fi

# ==================== MODE INTERACTIF ====================
DATE=""
read -p "${MSG[ask_list_dates]} " show_list
if [[ "$show_list" =~ ^[OoYy] ]] || [[ -z "$show_list" ]]; then
    list_available_dates
fi

read -p "${MSG[ask_date_prompt]} " response
if [[ "$response" =~ ^[OoYy] ]]; then
    read -p "${MSG[enter_date]} " DATE
    validate_date_strict "$DATE" || exit 1
else
    DATE=$(date '+%Y-%m-%d')
fi

HISTORY_DATA=$(grep "^${DATE}" /var/log/zypp/history 2>/dev/null || true)
[[ -z "$HISTORY_DATA" ]] && echo "${MSG[no_data]} $DATE" && exit 0

read -p "${MSG[ask_output]} " output_choice
if [[ "$output_choice" =~ ^[Ff] ]]; then
    create_csv "$DATE" "$HISTORY_DATA"; exit 0
fi

{ display_history "$DATE" "$HISTORY_DATA" "$FILTER_MODE"
  echo "===================================================================================="
  echo "${MSG[end_history]}"
  echo ""
  echo "${MSG[search_help]}"
  echo "${MSG[quit_help]}"; } | less -R

exit 0
